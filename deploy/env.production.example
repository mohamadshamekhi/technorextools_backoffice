# روی سرور به ریشه‌ی ریپو کپی شود: cp deploy/env.production.example .env.production
# هرگز commit نشود.
NODE_ENV=production
PORT=3001
# آدرس پایه‌ی API (نسخه‌دار). health خود API غیرنسخه‌دار است: https://api.technorextools.com/health
API_BASE_URL=https://api.technorextools.com/api/v1
# باید دقیقاً با مقدار env پروداکشن abzar/api یکی باشد؛ روی هدر X-Service-Token فرستاده می‌شود.
API_SERVICE_TOKEN=
